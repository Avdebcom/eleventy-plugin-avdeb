{
	"name": "eleventy-plugin-avdeb",
	"version": "0.1.0",
	"description": "Eleventy plugin for AVDEB products: grid, carousel, list and spotlight embeds with your affiliate referral code on every link",
	"type": "module",
	"main": "./index.js",
	"types": "./index.d.ts",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"default": "./index.js"
		},
		"./avdeb.css": "./src/avdeb.css",
		"./avdeb.js": "./src/avdeb.js",
		"./package.json": "./package.json"
	},
	"files": [
		"index.js",
		"index.d.ts",
		"src",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"keywords": [
		"eleventy",
		"eleventy-plugin",
		"11ty",
		"shortcode",
		"affiliate",
		"affiliate-links",
		"products",
		"product-embed",
		"carousel",
		"avdeb"
	],
	"homepage": "https://avdeb.com/developers/#eleventy",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Avdebcom/eleventy-plugin-avdeb.git"
	},
	"bugs": {
		"url": "https://github.com/Avdebcom/eleventy-plugin-avdeb/issues"
	},
	"author": {
		"name": "AVDEB",
		"url": "https://avdeb.com/developers/"
	},
	"license": "MIT",
	"engines": {
		"node": ">=18"
	},
	"11ty": {
		"compatibility": ">=3.0"
	},
	"devDependencies": {
		"@11ty/eleventy": "^3.1.2"
	},
	"scripts": {
		"test": "node --test tests/*.test.js",
		"demo": "cd demo && npx @11ty/eleventy --serve"
	}
}
